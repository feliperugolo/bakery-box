# Copiá este archivo a ".env.local" y completá con los datos de tu proyecto de Supabase
# (Supabase -> Project Settings -> API)

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Número de WhatsApp del negocio (con código de país, sin +, sin espacios)
NEXT_PUBLIC_WHATSAPP_NUMBER=5491162797363

# --- Bot de WhatsApp (opcional: sin esto el sitio funciona igual, solo no hay bot) ---

# Supabase -> Project Settings -> API -> Project API keys -> "service_role"
# (NUNCA con el prefijo NEXT_PUBLIC_: esta clave no debe llegar al navegador)
SUPABASE_SERVICE_ROLE_KEY=

# Meta -> WhatsApp -> API Setup: token permanente del System User y el
# Phone number ID (no es el número, es un id interno de Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Inventalo vos (cualquier string secreto): tenés que poner el mismo valor
# al configurar el webhook en el panel de Meta
WHATSAPP_VERIFY_TOKEN=

# console.anthropic.com -> API Keys. Es lo que usa el bot para entender y
# responder los mensajes.
ANTHROPIC_API_KEY=
